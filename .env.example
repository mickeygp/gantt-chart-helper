# Cloud sync (optional).
#
# Leave these unset and the app behaves exactly as before: everything lives in
# this browser's localStorage and the cloud UI stays hidden.
#
# Copy this file to `.env.local` and fill in the values from your Supabase
# project: Dashboard -> Project Settings -> Data API / API Keys.
#
# The anon key is a publishable key and is meant to ship in the browser bundle.
# Access is enforced by row-level security, not by hiding this value. Never put
# the `service_role` key here — it bypasses every policy.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
